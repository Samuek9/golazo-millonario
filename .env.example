# ─── Flask ──────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ─── Base de datos PostgreSQL (Neon) ─────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Golazo Millonario ────────────────────────────────────────────────────────
RIFA_NAME=Golazo Millonario 2026
CODE_PRICE_COP=10000
MAX_PACKS_PER_ORDER=10

# ─── Wompi ────────────────────────────────────────────────────────────────────
# Misma cuenta Wompi que torneo-xanderstv (decisión del cliente) — copiar tal cual
# desde /c/Users/Windows/Documents/torneo/.env
WOMPI_SANDBOX=false
WOMPI_PUBLIC_KEY=pub_prod_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_prod_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_EVENTS_KEY=prod_events_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_KEY=prod_integrity_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── URL pública de la app ────────────────────────────────────────────────────
APP_URL=https://golazo-millonario.vercel.app

# ─── Email ────────────────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=golazomillonario@resend.dev
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Panel admin ─────────────────────────────────────────────────────────────
ADMIN_SECRET=clave-secreta-admin-cambiar
